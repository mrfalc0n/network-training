# containerlab runtime artifacts — generated on every deploy, never committed
clab-*/
.clab-*
*.clab.yml.bak
.tmp/

# containerlab writes a graph/ dir and topology export files
graph/
*.drawio
topology-data.json

# device images are large and license-restricted — never commit
*.tar
*.tar.xz
*.qcow2
*.vmdk

# Ansible (Phase 3+)
*.retry
.vault_pass
inventory/host_vars/**/vault.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
